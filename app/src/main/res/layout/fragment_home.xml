<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fsa_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_greeting"
            android:textColor="@color/fsa_ink"
            android:textSize="22sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_sub"
            android:textColor="@color/fsa_dim"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/txt_home_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="● checking…"
            android:textColor="@color/fsa_amber"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_face"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Open the circuit board face"
            android:textColor="@color/fsa_bg"
            app:backgroundTint="@color/fsa_green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hold_talk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hold to talk"
            android:textColor="@color/fsa_green"
            app:backgroundTint="@color/fsa_surface"
            app:strokeColor="@color/fsa_chrome"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="THE STACK"
            android:textColor="@color/fsa_dim"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/txt_stack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/fsa_ink"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</ScrollView>
